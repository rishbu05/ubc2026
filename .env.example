# Copy to .env (or .env.local) and fill in. Never commit real values.
# Network is Solana DEVNET everywhere.

# ── App ────────────────────────────────────────────────────────────────
# Public base URL of this app (used for Solana Pay transaction-request links and x402 resource URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL wallets use for Solana Pay links (the Vercel URL, even locally; public, used by ApprovalModal QR). Falls back to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SOLANA_PAY_BASE_URL=

# ── Solana (devnet) ────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# x402 / CAIP-2 network id for Solana devnet
NEXT_PUBLIC_SOLANA_CAIP2=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Devnet USDC mint (Circle)
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ── x402 (paid data endpoints in app/api/paid/*) ───────────────────────
# Seller wallet: Solana address that receives x402 payments for app/api/paid/*
X402_PAY_TO_ADDRESS=
# Facilitator that verifies/settles x402 payments
X402_FACILITATOR_URL=https://x402.org/facilitator

# ── Circle Developer-Controlled Wallets (agent's wallet) ───────────────
CIRCLE_API_KEY=
# 32-byte hex entity secret registered with Circle
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# Wallet the agent spends from (blockchain: SOL-DEVNET)
CIRCLE_AGENT_WALLET_ID=
# Its address. Public: the browser needs it for SPL approve() (DelegatePanel).
# Fund with devnet USDC (https://faucet.circle.com) and a little devnet SOL (delegate top-ups pay fees).
NEXT_PUBLIC_AGENT_WALLET_ADDRESS=

# ── Gemini EXCHANGE — Prediction Markets REST API (lib/gemini.ts) ──────
# This is the Gemini crypto exchange (developer.gemini.com), NOT Google Gemini AI.
# Orders: SANDBOX (GEMINI_API_BASE_URL). Market data: PRODUCTION (GEMINI_MARKET_DATA_URL). Public endpoints need no key.
GEMINI_API_BASE_URL=https://api.sandbox.gemini.com
# Public market data (events, books, candles, tickers) comes from PRODUCTION. Orders never go here.
GEMINI_MARKET_DATA_URL=https://api.gemini.com
# Sandbox API key + secret (exchange.sandbox.gemini.com > Settings > API). Needs Trader role.
GEMINI_API_KEY=
GEMINI_API_SECRET=

# ── Supabase (policies, spend ledger, approvals) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Internal auth ──────────────────────────────────────────────────────
# Shared secret for server-only agent routes (/api/agent/*, POST /api/approve).
# Callers send header  x-agent-secret: <value>. Generate: openssl rand -hex 32
AGENT_INTERNAL_SECRET=

# ── Spending policy defaults (lib/policy.ts) ───────────────────────────
# Amounts in USDC (human units). MAX_PER_TX = per x402 data call; daily limit covers data + trades.
POLICY_MAX_PER_TX_USDC=0.10
POLICY_DAILY_LIMIT_USDC=5.00
# Spends above this need human approval via Solana Pay (app/api/approve/*)
POLICY_APPROVAL_THRESHOLD_USDC=2.00
# true = every prediction-market trade needs human approval, regardless of size
POLICY_TRADES_REQUIRE_APPROVAL=true

# Dev/test pages (/dev/approval). Turn off for public demos.
ENABLE_DEV_PAGES=true
# DEMO: append a prompt-injection headline to /api/paid/news for every request (or use ?inject=1)
DEMO_INJECTION=false
